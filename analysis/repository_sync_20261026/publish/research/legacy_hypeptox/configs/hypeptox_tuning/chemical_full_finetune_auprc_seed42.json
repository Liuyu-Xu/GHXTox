    "group_embedding_dim": 12,
    "hidden_dim": 128,
    "num_sequence_layers": 2,
    "num_egnn_layers": 3,
    "num_attention_heads": 4,
    "dropout": 0.18,
    "graph_mode": "hybrid",
    "spatial_top_k": 10,
    "rbf_bins": 16,
    "rbf_max_distance": 24.0,
