{
  "seed": 2026,
  "data": {"max_length": 128, "structure_mode": "cached", "structure_cache_dir": "data/structures"},
  "model": {
    "aa_embedding_dim": 32, "group_embedding_dim": 12, "hidden_dim": 128,
    "num_sequence_layers": 2, "num_egnn_layers": 3, "num_attention_heads": 4, "dropout": 0.22,
    "graph_mode": "hybrid", "spatial_top_k": 10, "rbf_bins": 16, "rbf_max_distance": 24.0,
    "fusion_gate": "learned_confidence", "ahp_initial_3d_weight": 0.35,
    "plddt_gate_center": 0.7, "plddt_gate_temperature": 0.12,
    "plddt_edge_min": 0.1, "plddt_edge_power": 1.5, "plm_embedding_dim": 1280,
    "structure_feature_dim": 16, "global_features": true,
    "chemical_site_branch": true, "chemical_site_type_dim": 8, "chemical_site_hidden_dim": 64,
    "chemical_site_layers": 2, "chemical_site_raw_rbf_bins": 16,
    "chemical_site_normalized_rbf_bins": 8, "chemical_site_max_distance": 16.0,
    "chemical_site_normalized_max_distance": 4.0, "chemical_site_dropout": 0.1,
    "chemical_site_use_raw_rbf": true, "chemical_site_use_normalized_rbf": true,
    "chemical_site_use_orientation": true, "chemical_site_use_interaction_types": true,
    "chemical_site_use_plddt": true, "chemical_site_use_hydrophobic_sites": true,
    "chemical_site_max_site_slots": 2, "chemical_site_exclude_same_residue": true,
    "chemical_site_zero_init_residual": true
  },
  "train": {
    "epochs": 12, "batch_size": 16, "learning_rate": 0.0005, "weight_decay": 0.0001,
    "pos_weight": "auto", "coord_noise_std": 0.12, "coord_noise_plddt_scale": 2.0,
    "monitor": "mcc", "selection_mode": "fixed_epoch", "save_auxiliary_checkpoints": false
  },
  "experiment": {
    "name": "topology_strict_base_v1", "purpose": "Frozen scratch base for strict nested topology OOF.",
    "selection_policy": "Epoch 12 is fixed before candidate OOF; inner validation is diagnostic only.",
    "external_test_labels_used": false
  }
