\begin{figure}[htbp]
    \centering
    \includegraphics[width=\linewidth]{fig1_ghxtox_framework.png}
    \caption{GHXTox framework. The peptide sequence follows parallel sequence
    and structure pathways. The sequence pathway uses ProtT5 tokenization for
    the 1D model, whereas the structure pathway uses multi-conformer training
    and single-structure inference with pLDDT-aware structural inputs for the
    3D model.}
    \label{fig:overview}
\end{figure}
\efloatseparator
 
\begin{figure}[htbp]
    \centering
    \includegraphics[width=\linewidth]{fig3_discrimination_calibration.pdf}
    \caption{GHXTox discrimination and probability reliability. (A--C) test set 1
    ROC, precision--recall, and reliability curves; (D--F) corresponding test set 2
    curves. Orange, blue, and navy denote the task-adaptive 1D expert, the 3D
    structural expert, and probability fusion, respectively. Gray dashed lines
    denote chance, prevalence, or ideal-reference behavior.}
    \label{fig:discrimination_calibration}
\end{figure}
\efloatseparator
 
\begin{figure}[htbp]
    \centering
    \includegraphics[width=\linewidth]{expert_disagreement_analysis.pdf}
    \caption{Complementarity of the 1D and 3D experts on test set 1 and test set 2.
    (A) Expert-outcome groups and their toxic fractions. (B) Conditional rescue
    rates with 95\% Wilson intervals. (C) Prespecified 3D-only versus 1D-only
    attribute effects with 95\% bootstrap intervals; none remained significant
    after Benjamini--Hochberg correction.}
    \label{fig:expert_complementarity}
\end{figure}
\efloatseparator
 
\begin{figure}[htbp]
    \centering
    \includegraphics[width=\linewidth]{fig5_module_ablation.pdf}
    \caption{Protocol-separated structural ablations. (A, B) Previous and
    pLDDT-aware 3D experts on test set 1 and test set 2. (C) Training-OOF comparison
    without and with chemical-site information.}
    \label{fig:module_ablation}
\end{figure}
\efloatseparator
 
\begin{figure}[htbp]
    \centering
    \includegraphics[width=\linewidth]{selective_prediction_combined.pdf}
    \caption{OOF-frozen selective prediction and benchmark transfer. (A, B)
    Training-OOF accepted error and MCC across coverage levels. (C--E) Realized
    coverage, accepted error, and MCC after applying the unchanged cutoff to
    test set 1 and test set 2. Shading and error bars denote the manuscript-defined 95\%
    bootstrap intervals; no benchmark-specific cutoff was recomputed.}
    \label{fig:selective_prediction}
\end{figure}
\efloatseparator
 
\begin{figure}[htbp]
    \centering
    \includegraphics[width=0.94\linewidth]{structural_sensitivity.pdf}
    \caption{Structure-confidence and chemical-site sensitivity. (A) Mean
    pLDDT versus the peptide-level structural gate. (B) Within-peptide
    pLDDT--node-gate associations. (C) Category-level and (D) largest
    individual-site deletion effects. Deletion effects denote model sensitivity,
    not experimentally verified toxicophores.}
    \label{fig:structural_sensitivity}
\end{figure}
\efloatseparator
 
\begin{figure}[htbp]
    \centering
    \includegraphics[width=\linewidth]{expert_disagreement_cases.pdf}
    \caption{Representative expert disagreements. (A) Structural evidence
    rescues a toxic decision missed by the 1D expert. (B) Opposing structural
    evidence reverses a correct 1D decision. Bars show expert and fused
    probabilities relative to the frozen threshold; the cases are illustrative,
    not causal biological evidence.}
    \label{fig:expert_disagreement_cases}
