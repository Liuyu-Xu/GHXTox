{
  "seed": 42,
  "data": {
    "max_length": 128,
    "structure_mode": "cached",
    "structure_cache_dir": "data/structures"
  },
  "model": {
    "aa_embedding_dim": 32,
    "group_embedding_dim": 12,
    "hidden_dim": 128,
    "num_sequence_layers": 2,
    "num_egnn_layers": 3,
    "num_attention_heads": 4,
    "dropout": 0.22,
    "graph_mode": "hybrid",
    "spatial_top_k": 10,
    "rbf_bins": 16,
    "rbf_max_distance": 24.0,
    "fusion_gate": "learned_confidence",
    "ahp_initial_3d_weight": 0.35,
    "plddt_gate_center": 0.7,
    "plddt_gate_temperature": 0.12,
    "plddt_edge_min": 0.1,
    "plddt_edge_power": 1.5,
    "plm_embedding_dim": 1280,
    "structure_feature_dim": 16,
    "global_features": true,
    "chemical_site_branch": true,
    "chemical_site_type_dim": 8,
    "chemical_site_hidden_dim": 64,
    "chemical_site_layers": 2,
    "chemical_site_raw_rbf_bins": 16,
    "chemical_site_normalized_rbf_bins": 8,
    "chemical_site_max_distance": 16.0,
    "chemical_site_normalized_max_distance": 4.0,
    "chemical_site_dropout": 0.1,
    "chemical_site_use_raw_rbf": true,
    "chemical_site_use_normalized_rbf": true,
    "chemical_site_use_orientation": true,
    "chemical_site_use_interaction_types": true,
    "chemical_site_use_plddt": true,
    "chemical_site_use_hydrophobic_sites": true,
    "chemical_site_max_site_slots": 2,
    "chemical_site_exclude_same_residue_edges": false,
    "chemical_site_zero_init_residual": true,
    "conformer_ensemble_branch": true,
    "conformer_ensemble_source_aware": true,
    "conformer_ensemble_hidden_dim": 32,
    "conformer_ensemble_dropout": 0.25,
    "conformer_ensemble_initial_weight": 0.25,
    "conformer_graph_set_branch": true,
    "conformer_graph_hidden_dim": 32,
    "conformer_graph_layers": 2,
    "conformer_set_attention_heads": 4,
    "conformer_graph_raw_rbf_bins": 8,
    "conformer_graph_normalized_rbf_bins": 8,
    "conformer_graph_max_distance": 16.0,
    "conformer_graph_normalized_max_distance": 4.0,
    "conformer_graph_dropout": 0.15,
    "conformer_graph_initial_weight": 0.15
  },
  "train": {
    "epochs": 30,
    "batch_size": 64,
    "learning_rate": 0.0005,
    "weight_decay": 0.0005,
    "val_fraction": 0.15,
    "early_stop_patience": 5,
    "pos_weight": "none",
    "coord_noise_std": 0.0,
    "monitor": "auprc",
    "initial_checkpoint": "runs/multisource_1_30_full2795_rank_stable_fold{fold}/best_model.pt",
    "allowed_missing_prefixes": [
      "conformer_graph_set_encoder.",
      "conformer_graph_source_heads.",
      "conformer_graph_source_logits"
    ],
    "trainable_prefixes": [
      "conformer_graph_set_encoder.",
      "conformer_graph_source_heads.",
      "conformer_graph_source_logits"
    ],
    "conformer_delta_l1": 0.01
  },
  "inference": {
    "default_threshold": 0.677819,
    "threshold_source": "frozen original 3D-v2 group-aware OOF threshold",
    "conformer_missing_policy": "hard-zero graph residual over the retained source-aware summary residual"
  },
  "experiment": {
    "name": "bioemu600_boundary_conformer_graph_on_summary_residual",
    "scope": "frozen 600-row BioEmu decision-boundary cohort (11-15/16-30/31-50 aa), targetized per-conformer functional-group graph + set-attention",
    "architecture": "retained multisource summary-statistics residual as frozen parent; train only the per-conformer functional-group graph, set-attention and source-specific heads on the 600 BioEmu boundary rows",
    "parent_checkpoint": "runs/multisource_1_30_full2795_rank_stable_fold{fold}/best_model.pt",
    "coverage": "600/6387 training rows; rows outside the frozen boundary cohort remain exact fallback"
  }
}