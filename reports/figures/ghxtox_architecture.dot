digraph GHXTox {
  rankdir=TB;
  graph [fontname="Microsoft YaHei", splines=ortho, nodesep=0.45, ranksep=0.5, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=11, margin="0.18,0.10"];
  edge  [color="#4a6fa5", penwidth=1.4, arrowsize=0.8];

  // ===== 输入层 =====
  subgraph cluster_in {
    label="输入层"; fontsize=14; fontname="Microsoft YaHei"; style="rounded,filled"; color="#d9c9a3"; fillcolor="#fffaf0";
    in_seq  [label="肽序列\n(11–50 aa)", fillcolor="#fff3d6", color="#b38600"];
    in_esm  [label="ESM2-650M\n上下文残基表征", fillcolor="#fff3d6", color="#b38600"];
    in_pdb  [label="ESMFold 全原子 PDB\n+ 逐残基 pLDDT", fillcolor="#fff3d6", color="#b38600"];
    in_conf [label="PepFlow / AF2\n多构象集合（可选）", fillcolor="#fff3d6", color="#b38600"];
  }

  // ===== 1D 序列线路 =====
  subgraph cluster_1d {
    label="1D 序列线路"; fontsize=14; fontname="Microsoft YaHei"; style="rounded,filled"; color="#9db8d2"; fillcolor="#f2f7fc";
    d1 [label="ProtT5-XL-UniRef50 编码\n均值池化（含 EOS）→ 1024 维", fillcolor="#e3eefb", color="#2f5597"];
    d2 [label="线性投影 1024→128\n+ BatchNorm", fillcolor="#e3eefb", color="#2f5597"];
    d3 [label="多尺度 TextCNN\n窗口 4 / 5 / 6\n+ 全局最大池化 + 全连接", fillcolor="#e3eefb", color="#2f5597"];
    d4 [label="折内 1:1 Borderline-SMOTE\n（严格训练折内合成，防泄漏）", fillcolor="#e3eefb", color="#2f5597"];
    d5 [label="15 成员等权集成\n（3 随机种子 × 5 同源组折）", fillcolor="#e3eefb", color="#2f5597"];
    d6 [label="序列概率 p_prott5\n（阈值 0.45）", fillcolor="#cfe0f5", color="#1f5c8b", penwidth=1.8];
  }

  // ===== 3D 结构线路 =====
  subgraph cluster_3d {
    label="3D 结构线路（五级尺度）"; fontsize=14; fontname="Microsoft YaHei"; style="rounded,filled"; color="#a8c9b0"; fillcolor="#f2faf4";
    s1 [label="① 残基尺度\nAA/官能团嵌入 + 42D 理化\n+ ESM2 投影", fillcolor="#dff0e4", color="#1e7a46"];
    s2 [label="② 原子化学位点尺度\n8 类可重叠属性 + 方向\nTyr / Trp 双位点", fillcolor="#dff0e4", color="#1e7a46"];
    s3 [label="③ 空间邻域尺度\npLDDT-aware Cα-EGNN\n序列边 + 空间 top-10 近邻\n双尺度 RBF（0–16 埃 / 0–4 Rg）", fillcolor="#dff0e4", color="#1e7a46"];
    s4 [label="③ 全原子化学位点\n相互作用残差（零初始化）", fillcolor="#dff0e4", color="#1e7a46"];
    s5 [label="④ 肽级全局尺度\n两级 pLDDT 门控 + 5D 全局特征\n+ 12D 官能团摘要", fillcolor="#dff0e4", color="#1e7a46"];
    s6 [label="⑤ 构象集合尺度\n接触占有率 / RMSF / 距离方差\n（硬掩码回退）", fillcolor="#dff0e4", color="#1e7a46"];
    s7 [label="结构概率 p_structure", fillcolor="#c9e6d2", color="#145a32", penwidth=1.8];
  }

  // ===== 融合与下游 =====
  f1 [label="概率融合\n0.62 × p_prott5 + 0.38 × p_structure\n（OOF 冻结静态权重，联合阈值 0.60）", fillcolor="#f0e6fb", color="#7b3fa0", penwidth=1.8];
  a1 [label="跨模态交互适配器\nQuery = ProtT5 逐残基 token\nKey/Value = pLDDT 加权 3D 状态 + 12D 化学位点摘要\n零初始化有界 logit 残差", fillcolor="#e6f7ef", color="#1e8449"];
  b1 [label="BACC 决策修正（概率不变）\n仅当序列专家与联合判断分歧\n且 gate ≥ 0.9299 时以序列判断替代联合类别", fillcolor="#fdecea", color="#c0392b"];
  out [label="输出\ntoxicity_probability + prediction\n+ 交互修正量 / 决策激活 / 回退状态审计字段", fillcolor="#fef9e7", color="#b7950b", penwidth=1.8];

  // ===== 边 =====
  in_seq -> d1; in_esm -> d1; in_pdb -> s1; in_conf -> s6;
  d1 -> d2 -> d3 -> d4 -> d5 -> d6;
  s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7;
  d6 -> f1; s7 -> f1;
  f1 -> a1 -> b1 -> out;
}
