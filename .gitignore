# =========================
# 1. Python 缓存和运行文件
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# 2. 虚拟环境（最容易导致体积超标）
# =========================
venv/
env/
.env/
.venv/
.venv-bioemu-*/
Scripts/
Lib/

# Keep the project-level AutoDL launcher while still ignoring environment Scripts/.
!/scripts/
/scripts/*
!/scripts/generate_prott5_pooled_autodl.sh
!/scripts/generate_prott5_tokens_autodl.sh
!/scripts/install_colabfold_autodl.sh
!/scripts/run_colabfold_16_30_autodl.sh
!/scripts/evaluate_colabfold_16_30_oof.ps1
!/scripts/evaluate_colabfold_31_50_oof.ps1
!/scripts/evaluate_bidirectional_coupling_oof.ps1
!/scripts/evaluate_bidirectional_coupling_oof.sh
!/scripts/install_bioemu_autodl.sh
!/scripts/run_bioemu_pilot_autodl.sh

# =========================
# 3. 深度学习模型权重
# =========================
*.pt
*.pth
*.h5
*.ckpt
*.safetensors

# =========================
# 4. 数据集和临时大文件
# =========================
*.csv
*.tsv
*.npy
*.npz
*.fasta
!/runs/prott5_structure_bidirectional_agreement_oof/oof_predictions.csv
/data/*
!/data/pepflow_pilot/
/data/pepflow_pilot/*
!/data/pepflow_pilot/train_pilot_250.fasta
!/data/pepflow_pilot/train_pilot_250.csv
!/data/af2_ensemble_16_30/
/data/af2_ensemble_16_30/*
!/data/af2_ensemble_16_30/smoke_2.fasta
!/data/af2_ensemble_16_30/smoke_2.csv
!/data/af2_ensemble_16_30/train_pilot_400.fasta
!/data/af2_ensemble_16_30/train_pilot_400.csv
!/data/af2_ensemble_16_30/train_full_2034.fasta
!/data/af2_ensemble_16_30/train_full_2034.csv
!/data/af2_ensemble_16_30/task_summary.json
!/data/af2_ensemble_31_50/
/data/af2_ensemble_31_50/*
!/data/af2_ensemble_31_50/train_pilot_400.fasta
!/data/af2_ensemble_31_50/train_pilot_400.csv
!/data/bioemu_pilot/
/data/bioemu_pilot/*
