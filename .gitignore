/dataset/
/temp/

# BioEmu raw trajectories, batches and caches stay off Git; keep only the decision.
/runs/bioemu_pilot_200/*
!/runs/bioemu_pilot_200/decision.json
/runs/bioemu_pilot_200_dry_run/

