# =========================
# 1. Python 缓存和运行文件
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# 2. 虚拟环境（最容易导致体积超标）
# =========================
venv/
env/
.env/
.venv/
.venv-bioemu-*/
Scripts/
Lib/

# Keep the project-level AutoDL launcher while still ignoring environment Scripts/.
!/scripts/
/scripts/*
!/scripts/generate_prott5_pooled_autodl.sh
!/scripts/generate_prott5_tokens_autodl.sh
!/scripts/install_colabfold_autodl.sh
!/scripts/run_colabfold_16_30_autodl.sh
!/scripts/evaluate_colabfold_16_30_oof.ps1
!/scripts/evaluate_colabfold_31_50_oof.ps1
!/scripts/evaluate_bidirectional_coupling_oof.ps1
!/scripts/evaluate_bidirectional_coupling_oof.sh
!/scripts/install_bioemu_autodl.sh
!/scripts/run_bioemu_pilot_autodl.sh
!/scripts/evaluate_3d_v2_multiseed_oof.ps1
!/scripts/evaluate_3d_v2_multiseed_oof.sh
!/scripts/evaluate_short_margin_3d_oof.ps1
!/scripts/evaluate_short_margin_3d_oof.sh
!/scripts/evaluate_ensemble_domain_ssl_3d_oof.ps1
!/scripts/evaluate_ensemble_domain_ssl_3d_oof.sh
!/scripts/evaluate_length_calibration_3d_oof.ps1
!/scripts/evaluate_length_calibration_3d_oof.sh
!/scripts/evaluate_partial_unfreeze_3d_oof.ps1
!/scripts/evaluate_partial_unfreeze_3d_oof.sh
!/scripts/run_boundary_bioemu_autodl.sh

# Keep the frozen Phase 30 protocol and compact reports, not fold weights/logs.
/runs/ensemble_domain_ssl_3d/fold_*/
/runs/partial_unfreeze_3d/fold_*/
/runs/partial_unfreeze_3d/*.log

# Keep the frozen Phase 29 protocol and compact reports, not fold weights/logs.
/runs/short_margin_3d/fold*/

