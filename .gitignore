# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
venv/
env/
.env/
.venv/
Scripts/
Lib/

# Local configuration
.vscode/
.idea/
.DS_Store
Thumbs.db

# Deep-learning checkpoints and model artifacts
*.pt
*.pth
*.h5
*.ckpt
*.safetensors

# Raw, processed, and intermediate data
/data/
/dataset/
/temp/
*.fasta
*.fa
*.faa
*.csv
*.tsv
*.npy
*.npz
*.pdb

# Keep small paper/report tables versioned.
!reports/**/*.csv
!reports/**/*.tsv

# Training runs are usually reproducible intermediates. Keep already tracked
# historical summaries, but do not add new run directories by accident.
/runs/

# Logs and local archives
*.log
*.out
*.err
*.tar
*.tar.gz
*.zip
*.7z

# Paper/source-document extraction scratch space
/hyptox_doc_extract/
/jcim_doc_extract/
*.docx
*.pptx
*.xlsx
*.xls

# Local planning/smoke artifacts
/findings.md
/progress.md
/task_plan.md
/reports/*_smoke/
